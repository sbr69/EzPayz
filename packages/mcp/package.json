{
  "name": "@ezpayz/mcp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MCP server for the EzPayz — exposes tools + docs resources to AI agents.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "whitechain-mcp": "dist/index.js"
  },
  "exports": {
    ".": { "import": "./dist/index.js", "types": "./dist/index.d.ts" },
    "./server": { "import": "./dist/server.js", "types": "./dist/server.d.ts" }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "5.9.3"
  }
}
