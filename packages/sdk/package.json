{
  "name": "@ezpayz/sdk",
  "private": false,
  "version": "0.1.1",
  "type": "module",
  "description": "EzPayz SDK — typed server client, React checkout widgets, webhook verification, and amount helpers for accepting gasless USDT payments on Whitechain Sepolia.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./browser": {
      "default": "./dist/browser-entry.global.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "NPM_PUBLISH.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsup"
  },
  "keywords": [
    "whitechain",
    "usdt",
    "payment",
    "gateway",
    "eip-3009",
    "crypto",
    "stablecoin",
    "checkout"
  ],
  "license": "MIT",
  "dependencies": {
    "viem": "^2.57.13"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "@types/react": "^19",
    "tsup": "^8.3.5",
    "typescript": "5.9.3"
  }
}
