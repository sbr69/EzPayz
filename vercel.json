{
  "name": "ezpayz",
  "buildCommand": "pnpm install && VITE_API_URL=https://ezpayz-api.onrender.com pnpm --filter @ezpayz/web build",
  "outputDirectory": "apps/web/dist",
  "installCommand": "pnpm install",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
