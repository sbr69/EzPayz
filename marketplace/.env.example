# Sill & Shelf — EzPayz integration (copy to `.env` and fill in)
# NOTE: this app is gitignored at `.env` — never commit real values.

# Neon Postgres (products + orders + x402 agent tables)
DATABASE_URL=

# This storefront's browser origin (hosted-checkout return URLs + origin checks)
APP_ORIGIN=http://localhost:3000

# EzPayz gateway API origin (payment intents + x402 facilitator)
# Local stack: http://localhost:4000 · Deployed: https://ezpayz-api.onrender.com
# Production must be HTTPS — HTTP is accepted only for localhost/127.0.0.1.
EZPAYZ_API_URL=https://ezpayz-api.onrender.com

# EzPayz hosted-checkout origin (where buyers are redirected to pay)
# Local stack: http://localhost:5173 · Deployed: https://ezpayz.vercel.app
EZPAYZ_CHECKOUT_ORIGIN=https://ezpayz.vercel.app

# Merchant secret API key (wcp_sec_… — shown once when the key is created in the
# EzPayz dashboard under Developers → API keys). Required for checkout + x402.
EZPAYZ_SECRET_KEY=

# HMAC-SHA256 endpoint secret for /api/webhooks/ezpayz (shown once when the
# webhook endpoint is created in the EzPayz dashboard).
EZPAYZ_WEBHOOK_SECRET=

# Merchant payout wallet (0x…) — receives USDT (must be verified in the EzPayz
# dashboard). Required for x402 quote/pay.
EZPAYZ_PAYOUT_WALLET=

# Developer x402 lab — server-side buyer wallet (0x + 64 hex), funded with test
# USDT, must differ from the payout wallet. Leave empty to disable the lab.
X402_AGENT_PRIVATE_KEY=

# Bearer token (>= 32 chars) gating the developer agent endpoint.
X402_OPERATOR_TOKEN=

# AI shopping/agent model (Groq, OpenAI-compatible endpoint)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
