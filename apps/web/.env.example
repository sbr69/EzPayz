# EzPayz web app — environment configuration
#
# Copy this file to `.env.local` (gitignored) and fill in real values.
# NEVER commit `.env.local` or real credentials to the repository.
#
# NOTE: this is a client-side SPA — everything prefixed VITE_ is inlined
# into the shipped JS bundle at build time. Do not put true secrets here.
# Demo access exists ONLY in builds where VITE_DEMO_MODE is exactly "true";
# production builds (flag unset) have the demo path compiled out entirely.

# Base URL of the gateway API (no trailing slash).
VITE_API_URL=https://ezpayz-api.onrender.com

# Demo mode master switch. Anything other than "true" disables demo access.
VITE_DEMO_MODE=false

# Demo credentials — only read when VITE_DEMO_MODE is "true".
# Leave empty in production environments.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
