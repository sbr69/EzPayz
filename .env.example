# Whitechain Payment Gateway — environment variables
# Copy to .env and fill in. NEVER commit .env. NEVER paste private keys in chat.

# ---- Whitechain Sepolia ----
WHITECHAIN_RPC_URL=https://rpc.testnet.whitechain.io
WHITECHAIN_WS_URL=wss://rpc.testnet.whitechain.io/ws
WHITECHAIN_CHAIN_ID=1874
WHITECHAIN_EXPLORER_URL=https://explorer.testnet.whitechain.io

# ---- Token ----
USDT_ADDRESS=0xcedfB56113143d55b2358b8CFbB0dEB5Ad2f55a7
USDT_DECIMALS=6

# ---- Subscription contract (filled in Phase 1 after deploy + verify) ----
SUBSCRIPTION_CONTRACT_ADDRESS=

# ---- Relayer (HACKATHON ONLY — .env with warnings; NOT for production) ----
# Pays WBT gas for EIP-3009 one-time submissions + subscription renewals.
RELAYER_PRIVATE_KEY=
RELAYER_ADDRESS=

# ---- PayeeShield (HACKATHON ONLY — single gateway EIP-712 signing key) ----
PAYEESHIELD_SIGNING_KEY=
PAYEESHIELD_KEY_ID=gwk_default

# ---- Auth ----
JWT_SECRET=

# ---- Database / Redis (Neon / Upstash — wired in Phase 2/3) ----
NEON_API_KEY=
DATABASE_URL=
REDIS_URL=
UPSTASH_EMAIL=your-upstash-account-email
UPSTASH_API_KEY=your-upstash-api-key

# ---- Phase 0 E2E test only (remove after EIP-3009 e2e verification) ----
# Funded test wallet that signs a transferWithAuthorization for the e2e test.
TEST_PAYER_PRIVATE_KEY=
TEST_PAYER_ADDRESS=
TEST_RECIPIENT_ADDRESS=
